{
  "data": "data/train.csv",
  "out": "models/rul_gru.pt",
  "model": "gru",
  "window": 96,
  "stride": 4,
  "rul_cap": 600.0,
  "hidden": 64,
  "layers": 2,
  "dropout": 0.2,
  "loss": "gaussian",
  "lr": 0.001,
  "weight_decay": 0.0001,
  "batch_size": 256,
  "epochs": 60,
  "patience": 10,
  "val_frac": 0.2,
  "seed": 0
}
